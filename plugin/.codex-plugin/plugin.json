{
  "name": "is-gpt-nerfed",
  "version": "0.5.3-windows.2",
  "description": "Windows port: passive inspection of the current local Codex session by default. Statistical fingerprint probes require explicit approval and an opt-in configuration; they use Codex account inference and do not prove model identity.",
  "author": {
    "name": "is-gpt-nerfed contributors"
  },
  "license": "MIT",
  "keywords": [
    "model routing",
    "downgrade",
    "integrity",
    "transparency",
    "codex",
    "justice"
  ],
  "skills": "./skills/",
  "hooks": {
    "description": "is-gpt-nerfed: passive session-integrity scan, probe scheduling, verdict delivery, optional halt",
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'command -v python3 >/dev/null 2>&1 || exit 0; P=\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}\"; S=\"$P/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || S=\"$HOME/.codex/is-gpt-nerfed/plugin/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || exit 0; exec python3 \"$S\" hook --event SessionStart'",
              "timeout": 10,
              "statusMessage": "is-gpt-nerfed: registering session",
              "commandWindows": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -EncodedCommand "
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'command -v python3 >/dev/null 2>&1 || exit 0; P=\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}\"; S=\"$P/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || S=\"$HOME/.codex/is-gpt-nerfed/plugin/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || exit 0; exec python3 \"$S\" hook --event UserPromptSubmit'",
              "timeout": 10,
              "additionalContextLimit": 4000,
              "commandWindows": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -EncodedCommand "
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": ".*",
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'command -v python3 >/dev/null 2>&1 || exit 0; P=\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}\"; S=\"$P/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || S=\"$HOME/.codex/is-gpt-nerfed/plugin/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || exit 0; exec python3 \"$S\" hook --event PreToolUse'",
              "timeout": 5,
              "additionalContextLimit": 4000,
              "commandWindows": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -EncodedCommand "
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'command -v python3 >/dev/null 2>&1 || exit 0; P=\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}\"; S=\"$P/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || S=\"$HOME/.codex/is-gpt-nerfed/plugin/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || exit 0; exec python3 \"$S\" hook --event Stop'",
              "timeout": 20,
              "statusMessage": "is-gpt-nerfed: scanning session for silent downgrades",
              "commandWindows": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -EncodedCommand "
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'command -v python3 >/dev/null 2>&1 || exit 0; P=\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}\"; S=\"$P/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || S=\"$HOME/.codex/is-gpt-nerfed/plugin/skills/is-gpt-nerfed/scripts/nerfed\"; [ -f \"$S\" ] || exit 0; exec python3 \"$S\" hook --event SessionEnd'",
              "timeout": 3,
              "commandWindows": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -EncodedCommand "
            }
          ]
        }
      ]
    }
  },
  "interface": {
    "displayName": "Is GPT nerfed?",
    "shortDescription": "Inspect routing evidence in local Codex sessions",
    "longDescription": "Windows plugin and CLI port. Defaults to current-session passive checks with no auth.json access, broad session discovery, scheduled inference, or update checks. Fingerprints are statistical evidence, not proof of model identity. Cloud-orchestrated dot threads do not run these local plugin hooks. The macOS app is not ported.",
    "developerName": "is-gpt-nerfed contributors",
    "category": "Developer Tools",
    "capabilities": [
      "Read"
    ],
    "defaultPrompt": [
      "$is-gpt-nerfed",
      "Did Codex silently downgrade this session? Use $is-gpt-nerfed.",
      "/side $is-gpt-nerfed"
    ],
    "brandColor": "#E5484D",
    "logo": "./assets/logo.png"
  }
}
